# ─── YOLO MODE ────────────────────────────────────────────────────────────────
# Set to true to remove the governor entirely.
# - Starts at tier YOLO_D (equivalent of HOT) from trade 1
# - Uses 40-65% of balance per trade
# - Observation window: 15s (vs 40s normal)
# - Re-entry cooldown: 90s (vs 20min normal)
# - TP1 disabled — no partial takes, ride to TP2 or trailing stop
# - TP2 targets: 250-750% depending on tier (vs 100-320% normal)
# - Moonbag active on EVERY win from the start
# - No daily loss limit — it runs until the wallet is empty or you stop it
# - Recommended when: you don't care about losing the starting capital
YOLO_MODE=false

# ─── REQUIRED ─────────────────────────────────────────────────────────────────
# PumpPortal API key — get from https://pumpportal.fun (fund your wallet there)
PUMPPORTAL_KEY=your_pumpportal_api_key_here

# Solana wallet address (for balance tracking only — trading is done via PumpPortal)
WALLET_ADDRESS=your_solana_wallet_pubkey_here

# Helius RPC endpoint — https://helius.dev (free tier works)
HELIUS_RPC=https://mainnet.helius-rpc.com/?api-key=your_helius_key

# ─── TRADE SIZING ─────────────────────────────────────────────────────────────
# SOL to spend per snipe (bot adapts this automatically based on performance)
SOL_PER_SNIPE=0.10

# Max concurrent open positions
MAX_POSITIONS=3

# Hard daily loss limit in SOL — bot halts if breached
DAILY_LOSS_LIMIT_SOL=0.50

# ─── EXIT STRATEGY ────────────────────────────────────────────────────────────
# Partial TP: sell 50 % of position at this gain %
# (default: +75 % = 1.75X on first half locks profit)
# TAKE_PROFIT_1_PCT=75

# Full TP: sell remaining 100 % at this gain %
# (default: +100 % = 2X)
# TAKE_PROFIT_2_PCT=100

# Hard stop-loss % (default: -30 %)
# STOP_LOSS_PCT=30

# Max hold time in seconds before forced exit (default: 300 = 5 min)
# MAX_HOLD_SEC=300

# ─── ENTRY FILTERS ────────────────────────────────────────────────────────────
# Minimum SOL already in the bonding curve at entry
MIN_SOL_IN_CURVE=3

# Max bonding curve fill % (0-100). Higher = token already pumped more
MAX_BONDING_CURVE_PCT=28

# Max % of supply held by the dev wallet
MAX_DEV_HOLDING_PCT=8

# Min unique wallets that bought during the observation window
MIN_UNIQUE_BUYERS=6

# Min buy/sell ratio during observation window (3:1 = very bullish)
MIN_BUY_SELL_RATIO=2.5

# Min SOL volume traded in the observation window
MIN_VOLUME_SOL_WINDOW=1.5

# Observation window in ms before deciding to enter (default: 40 000 = 40 s)
OBSERVATION_MS=40000

# ─── TELEGRAM (optional secondary signal source) ──────────────────────────────
# Leave blank to disable Telegram and rely only on the PumpFun WebSocket.
# To enable, generate a session string with: node auth-telegram.js
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION=

# Comma-separated Telegram group usernames to watch
TELEGRAM_GROUPS=fomocabal

# Comma-separated Telegram usernames whose CA calls trigger an immediate snipe
# (skips the observation window — only use for callers you trust)
TELEGRAM_USERS=marvcalledit,moodyelite
