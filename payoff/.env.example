# Pay Off environment — copy to .env and fill in from your Supabase project
# (Project Settings → API). Never commit .env.

# Used by the Expo app (EXPO_PUBLIC_ vars are embedded in the client bundle).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Feature flag: ship as a pure debt tracker by setting this to false while
# official sweepstakes rules are finalized with counsel.
EXPO_PUBLIC_DRAWINGS_ENABLED=true

# Used by scripts/seed.ts and the Supabase CLI (server-side only — keep secret).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
